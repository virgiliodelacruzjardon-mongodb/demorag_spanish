# URI de conexión de MongoDB Atlas
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>/

# API key usada únicamente para crear el embedding de la consulta.
# El modelo generativo corre localmente con Ollama.
VOYAGE_API_KEY=<tu_api_key>

# Valores opcionales
MONGODB_DATABASE=sample_mflix
MONGODB_COLLECTION=embedded_movies
VECTOR_INDEX_NAME=movie_plot_vector_index
VECTOR_FIELD=plot_embedding_voyage_3_large
VECTOR_DIMENSIONS=2048
VOYAGE_MODEL=voyage-3-large
OLLAMA_MODEL=llama3.2
